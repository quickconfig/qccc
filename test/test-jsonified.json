{
  "database": {
    "port": "7432",
    "sharding": { "keyspaces": "uid,pid,gid,nid,cid,sid", "enabled": "true" },
    "connection_timeout": "90",
    "pooling": {
      "max_lifetime_sec": "900",
      "max_active": "512",
      "min_idle": "2"
    },
    "cluster_id": "cluster-x91",
    "engine": "postgresql"
  },
  "network": {
    "max_retry_attempts": "9",
    "timeout_ms": "17000",
    "security": {
      "min_tls_version": "1.3",
      "cipher_suite": "TLS_AES_128_GCM_SHA256",
      "ssl_enabled": "true"
    },
    "base_path": "/api/v12/cluster/runtime///",
    "host": "edge.internal.example.net",
    "protocol": "https"
  },
  "logging": {
    "max_backup_files": "100",
    "level": "debug",
    "rotate_size_mb": "2048",
    "telemetry": {
      "scrape_interval_sec": "3",
      "prometheus_enabled": "true",
      "metrics_port": "9311"
    },
    "format": "json",
    "destination": "/opt/runtime////logs/main/runtime///server.log"
  },
  "compiler_settings": {
    "optimize": "Oz",
    "strict_aliasing": "false",
    "target": "riscv64",
    "inline_functions": "true",
    "flags": "-Winvalid-pch -Winvalid-offsetof -Winvalid-memory-model -Winvalid-imported-macros -Winvalid-utf8"
  },
  "memory_cache": {
    "eviction": "ARC",
    "max_memory_bytes": "17179869184",
    "ttl_seconds": "86400",
    "threading": {
      "io_threads": "32",
      "worker_threads": "96",
      "priority": "realtime"
    },
    "backend": "memcached"
  },
  "project": {
    "version_code": 42,
    "environment": "benchmark",
    "name": "Distributed HyperCompute Runtime",
    "version": "42.15.87"
  }
}
